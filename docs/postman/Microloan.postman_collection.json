{
  "info": {
    "name": "Microloan First 50%",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use fictional data only. Set passwords locally. Select the generated demo PNG for multipart upload. Alternative decisions require separate applications/documents."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "borrowerToken",
      "value": ""
    },
    {
      "key": "officerToken",
      "value": ""
    },
    {
      "key": "loanId",
      "value": ""
    },
    {
      "key": "kycId",
      "value": ""
    },
    {
      "key": "borrowerEmail",
      "value": "ananya.borrower@example.test"
    },
    {
      "key": "borrowerPassword",
      "value": ""
    },
    {
      "key": "officerEmail",
      "value": ""
    },
    {
      "key": "officerPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Approval workflow",
      "item": [
        {
          "name": "Register borrower",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ananya Rao\",\n  \"email\": \"{{borrowerEmail}}\",\n  \"password\": \"{{borrowerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.response.code===201) pm.collectionVariables.set(\"borrowerToken\",pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Borrower login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{borrowerEmail}}\",\n  \"password\": \"{{borrowerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.response.code===200) pm.collectionVariables.set(\"borrowerToken\",pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Officer login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{officerEmail}}\",\n  \"password\": \"{{officerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.response.code===200) pm.collectionVariables.set(\"officerToken\",pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Save profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/borrower/profile",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876501234\",\n  \"dateOfBirth\": \"1995-03-12\",\n  \"address\": \"Fictional Demo Street 1\",\n  \"city\": \"Bengaluru\",\n  \"state\": \"Karnataka\",\n  \"postalCode\": \"560001\",\n  \"occupation\": \"Tailor\",\n  \"employmentType\": \"SALARIED\",\n  \"monthlyIncome\": 45000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/borrower/profile",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Upload fictional KYC",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/borrower/kyc",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "documentType",
                  "value": "PAN",
                  "type": "text"
                },
                {
                  "key": "documentNumber",
                  "value": "DEMOP1234A",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.response.code===201) pm.collectionVariables.set(\"kycId\",pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List own KYC",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/borrower/kyc",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "View own KYC file",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/borrower/kyc/{{kycId}}/file",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Submit application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/borrower/loans",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loanAmount\": 100000,\n  \"purpose\": \"BUSINESS\",\n  \"purposeDescription\": \"Purchase equipment for tailoring business\",\n  \"tenureMonths\": 24,\n  \"existingMonthlyDebt\": 3000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.response.code===201) pm.collectionVariables.set(\"loanId\",pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List applications",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/borrower/loans",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Application",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/borrower/loans/{{loanId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Application details",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/borrower/loans/{{loanId}}/details",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Risk result",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/borrower/loans/{{loanId}}/risk",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Final decision",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/borrower/loans/{{loanId}}/decision",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Officer KYC queue",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/officer/kyc?status=PENDING",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{officerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Officer KYC detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/officer/kyc/{{kycId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{officerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Officer KYC file",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/officer/kyc/{{kycId}}/file",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{officerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Verify KYC",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/officer/kyc/{{kycId}}/verify",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{officerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Officer loan queue",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/officer/loans?status=SUBMITTED",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{officerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Officer loan details",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/officer/loans/{{loanId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{officerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Move to review",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/officer/loans/{{loanId}}/review",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{officerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Recalculate risk",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/officer/loans/{{loanId}}/risk",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{officerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Approve application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/officer/loans/{{loanId}}/decision",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{officerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"APPROVED\",\n  \"reason\": \"Verified demo documents and affordable obligations\",\n  \"approvedAmount\": 100000,\n  \"annualInterestRate\": 12\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Borrower final outcome",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/borrower/loans/{{loanId}}/details"
          }
        },
        {
          "name": "Borrower recorded decision",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/borrower/loans/{{loanId}}/decision"
          }
        }
      ]
    },
    {
      "name": "Alternative outcomes (separate records)",
      "item": [
        {
          "name": "Reject KYC (alternative to verify)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/officer/kyc/{{kycId}}/reject",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{officerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Document details are unreadable\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Reject application (alternative to approve)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/officer/loans/{{loanId}}/decision",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{officerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"REJECTED\",\n  \"reason\": \"Unable to verify declared information\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cancel application (before final decision)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/borrower/loans/{{loanId}}/cancel",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
